# Required: Claude API key (or run `ant auth login` locally)
ANTHROPIC_API_KEY=

# --- Deployment only (leave unset for local development) ---
# Shared access code gating the whole app (ADR 0020)
# ACCESS_CODE=
# Set automatically when you add Upstash Redis and Vercel Blob to the project (ADR 0019)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=

# --- Optional tuning ---
# CLAUDE_MODEL=claude-opus-5-5
# LESSON_QUESTIONS=10
# MAX_PDF_PAGES=100
# MAX_LESSONS_PER_IP_PER_DAY=10
# MAX_LESSONS_PER_DAY=100
# DATA_DIR=.data
